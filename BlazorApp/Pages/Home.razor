@page "/"

<PageTitle>Caleb Carlton | Designer and Developer</PageTitle>

<div class="portfolio-page">
      <header class="site-header">
            <a class="wordmark" href="/" aria-label="Caleb Carlton home">CC<span>.</span></a>
            <nav aria-label="Main navigation">
                  <a href="#work">Selected work</a>
                  <a href="#about">About</a>
                  <a class="header-contact" href="mailto:hello@example.com">Let's talk <span aria-hidden="true">↗</span></a>
            </nav>
      </header>

      <main>
            <section class="intro" aria-labelledby="intro-title">
                  <div class="intro-copy">
                        <p class="eyebrow">Designer + developer / Based in the Midwest</p>
                        <h1 id="intro-title">Thoughtful digital work for <em>real people.</em></h1>
                        <p class="intro-text">I’m Caleb, a curious builder who turns complex ideas into clear, useful experiences. This is a small corner of the internet for the things I’m making.</p>
                        <a class="button-link" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
                  </div>
            </section>

            <section class="signal-row" id="about" aria-label="Areas of focus">
                  <p>Currently exploring</p>
                  <div class="signal-list">
                        <span>Product design</span>
                        <span>Front-end craft</span>
                        <span>Visual systems</span>
                  </div>
            </section>

            <section class="work-section" id="work" aria-labelledby="work-title">
                  <div class="section-heading">
                        <p class="eyebrow">A few things I’ve made</p>
                        <h2 id="work-title">Selected <em>work</em></h2>
                        <p class="section-description">A growing collection of experiments, collaborations, and work in progress.</p>
                  </div>
                  <div class="project-grid">
                            <a class="project-card project-card-wide" id="project-01" href="#project-01">
                              <div class="project-art art-sunrise"><span>01</span><strong>PROJECT<br />ONE</strong></div>
                              <div class="project-meta"><h3>Project one</h3><p>Product / 2024</p><span class="arrow" aria-hidden="true">↗</span></div>
                        </a>
                            <a class="project-card" id="project-02" href="#project-02">
                              <div class="project-art art-blue"><span>02</span><strong>PROJECT<br />TWO</strong></div>
                              <div class="project-meta"><h3>Project two</h3><p>Identity / 2023</p><span class="arrow" aria-hidden="true">↗</span></div>
                        </a>
                            <a class="project-card" id="project-03" href="#project-03">
                              <div class="project-art art-green"><span>03</span><strong>PROJECT<br />THREE</strong></div>
                              <div class="project-meta"><h3>Project three</h3><p>Web / 2023</p><span class="arrow" aria-hidden="true">↗</span></div>
                        </a>
                  </div>
            </section>
      </main>

      <footer class="site-footer">
            <p>© 2024 Caleb Carlton</p>
            <p>More soon <span aria-hidden="true">✳</span></p>
      </footer>
</div>
